#-----------------------------------------
# Taps
#-----------------------------------------
tap 'homebrew/bundle'
tap 'homebrew/services'
tap 'anomalyco/tap'

#-----------------------------------------
# Brew CLI apps
#-----------------------------------------
brew 'mas'
brew 'vim'
brew 'wget'

#-----------------------------------------
# Dev
#-----------------------------------------
# general
brew 'git'
brew 'gh'
brew 'mole'

# terminal
brew 'zsh'
brew 'fzf'
brew 'neovim'

# ai
brew 'opencode-v2'

# containers
cask 'docker'

#-----------------------------------------
# App casks
#-----------------------------------------
cask '1password'
cask '1password-cli'
cask 'arc'
cask 'cursor'
cask 'karabiner-elements'
cask 'notion-calendar'
cask 'opencode-desktop'
cask 'raycast'
cask 'rectangle'
cask 'setapp'
cask 'slack'
cask 'tableplus'
cask 'zoom'

cask 'font-monaspace'
