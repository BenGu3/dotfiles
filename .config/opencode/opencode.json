{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/Users/benguthrie/repos/work/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch --show-current",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git remote -v",
      "effect": "allow"
    }
  ],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  },
  "providers": {},
  "agents": {
    "plan": {
      "model": ""
    },
    "build": {
      "model": ""
    }
  }
}
