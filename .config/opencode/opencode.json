{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/Users/benguthrie/repos/work/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git fetch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rebase *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git pull --ff-only *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git switch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git switch *--discard-changes*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch *--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch * -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch -C *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch * -C *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch *--merge*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch -m *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch * -m *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch * -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git ls-files *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch --show-current",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git remote -v",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git stash*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git stash *pop*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash *drop*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash *clear*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset *--hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git restore *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push * -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *+*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch -D *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git branch * -D *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git worktree remove *--force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git worktree remove -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git worktree remove * -f *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr view *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr list *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr checks *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh pr create *",
      "effect": "allow"
    }
  ],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/benguthrie/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/Users/benguthrie",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "providers": {},
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "deepseek": {
      "disabled": true
    },
    "orchestrator": {
      "description": "Plan, delegate, review, validate, and publish approved workflow tasks",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "builder",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "description": "Handle small scripts, research, and direct edits without the four-phase workflow",
      "mode": "primary",
      "model": "openai/gpt-6-luna"
    },
    "builder": {
      "description": "Implement one approved, narrowly scoped task and return validation evidence",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  }
}
