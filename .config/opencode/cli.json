{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "super+shift+k",
    "diff.open": "<leader>d",
    "opencode.status": "<leader>x",
    "prompt.skills": "<leader>s"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": true,
    "view": "split"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "indicators": "status",
    "enabled": true,
    "scope": "cwd",
    "layout": "vertical"
  },
  "debug": {
    "devtools": false,
    "timing": false,
    "turn_tokens": true
  }
}
